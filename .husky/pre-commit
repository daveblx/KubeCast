#!/bin/bash
# Pre-commit hook for kubecast
# Ensures TypeScript compilation and tests pass before committing

set -e

echo "🔍 Running pre-commit checks..."

# Check TypeScript compilation
echo "  ├─ Checking TypeScript..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "  │  ❌ TypeScript compilation failed"
  exit 1
fi
echo "  │  ✅ TypeScript OK"

# Run template tests
echo "  ├─ Running template validation tests..."
if node --test src/deploy/template.test.ts 2>&1 | grep -q "fail\|error"; then
  echo "  │  ❌ Template tests failed"
  exit 1
fi
echo "  │  ✅ Tests OK"

# Check for common issues
echo "  ├─ Checking for common issues..."

# Check for console.log statements (except in specific files)
if git diff --cached --name-only | grep -E "\\.ts$" | grep -v test; then
  if git diff --cached -- "*.ts" ":(exclude)src/deploy/template.test.ts" | grep -E "^\+.*console\.log" > /dev/null; then
    echo "  │  ⚠️  Found console.log statements in staged code"
    echo "  │     Use console.error for errors, or consider removing debug logs"
  fi
fi

echo "  └─ ✅ All checks passed!"
echo ""
echo "✨ Ready to commit!"
